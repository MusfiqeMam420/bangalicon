server {
    listen 80;
    listen [::]:80;
    server_name bangalicon.com www.bangalicon.com ctrl.bangalicon.com api.bangalicon.com cdn.bangalicon.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.bangalicon.com;

    ssl_certificate     /etc/ssl/cloudflare/bangalicon-origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/bangalicon-origin.key;

    return 301 https://bangalicon.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name bangalicon.com;

    ssl_certificate     /etc/ssl/cloudflare/bangalicon-origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/bangalicon-origin.key;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ctrl.bangalicon.com;

    ssl_certificate     /etc/ssl/cloudflare/bangalicon-origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/bangalicon-origin.key;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.bangalicon.com;

    ssl_certificate     /etc/ssl/cloudflare/bangalicon-origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/bangalicon-origin.key;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:5100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name cdn.bangalicon.com;

    ssl_certificate     /etc/ssl/cloudflare/bangalicon-origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/bangalicon-origin.key;

    location /free/ {
        alias /var/www/bangalicon/bangalicon-backend/cdn/free/;
        access_log off;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }

    location = /bundle-index.json {
        alias /var/www/bangalicon/bangalicon-backend/cdn/bundle-index.json;
        access_log off;
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
    }

    location / {
        return 404;
    }
}
